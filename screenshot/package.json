{
  "name": "@twinsearth/dsh-fang-screenshot",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Screenshot client module for dsh-Fang (Wengcheng): Ctrl+Shift+X captures the screen, copies the image to the clipboard, and never binds Ctrl+X.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "dsh-Fang contributors"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
