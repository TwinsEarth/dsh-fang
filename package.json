{
  "name": "@twinsearth/fang-dsh-plugin",
  "version": "3.8.10",
  "private": false,
  "type": "module",
  "description": "dsh-Fang (瓮城) — mother/fork plugin development environment for DeepSeek Harness: one readonly mother, a disposable child dsh-Web per task.",
  "exports": {
    ".": "./src/index.mjs",
    "./compose": "./src/compose.mjs",
    "./orchestrator": "./src/plugins/orchestrator.mjs",
    "./forker": "./src/plugins/forker.mjs",
    "./scorer": "./src/plugins/scorer.mjs",
    "./umbrella": "./src/plugins/umbrella.mjs",
    "./healer": "./src/plugins/healer.mjs",
    "./approver": "./src/plugins/approver.mjs",
    "./hot-reloader": "./src/plugins/hot-reloader.mjs",
    "./restart-guard": "./src/plugins/restart-guard.mjs",
    "./buffer-keeper": "./src/plugins/buffer-keeper.mjs",
    "./auditor": "./src/plugins/auditor.mjs",
    "./router": "./src/plugins/router.mjs",
    "./adapter": "./src/plugins/adapter.mjs",
    "./session-catalog": "./src/plugins/session-catalog.mjs",
    "./client": {
      "browser": "./client.js",
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./session-bridge": "./src/plugins/session-bridge.mjs",
    "./session-sync": "./src/plugins/session-sync.mjs",
    "./session-router": "./src/plugins/session-router.mjs",
    "./decision-center": "./src/plugins/decision-center.mjs",
    "./contract": "./src/contract/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@twinsearth/dsh-fang-queue-journal": "^0.1.8",
    "@twinsearth/dsh-fang-web-entry": "0.1.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  },
  "dependencies": {
    "@twinsearth/dsh-fang-node-compat": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwinsEarth/fang-dsh-plugin.git"
  },
  "homepage": "https://github.com/TwinsEarth/fang-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/TwinsEarth/fang-dsh-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fangctl": "./tools/fangctl.mjs"
  }
}
