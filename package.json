{
  "name": "@local/dsh-fang",
  "version": "3.1.35",
  "private": true,
  "type": "module",
  "description": "瓮城：DSH 的第一台虚拟机！插件开发狂魔、多任务并发狂与安全焦虑症患者的隔离沙箱：热更新坏了秒回滚，多开不崩各跑各的，危险代码进审核与独立沙箱。1 编排器 + 12 子插件。",
  "exports": {
    ".": "./src/index.mjs",
    "./compose": "./src/compose.mjs",
    "./orchestrator": "./src/plugins/orchestrator.mjs",
    "./forker": "./src/plugins/forker.mjs",
    "./scorer": "./src/plugins/scorer.mjs",
    "./umbrella": "./src/plugins/umbrella.mjs",
    "./healer": "./src/plugins/healer.mjs",
    "./approver": "./src/plugins/approver.mjs",
    "./hot-reloader": "./src/plugins/hot-reloader.mjs",
    "./restart-guard": "./src/plugins/restart-guard.mjs",
    "./buffer-keeper": "./src/plugins/buffer-keeper.mjs",
    "./auditor": "./src/plugins/auditor.mjs",
    "./router": "./src/plugins/router.mjs",
    "./adapter": "./src/plugins/adapter.mjs",
    "./session-catalog": "./src/plugins/session-catalog.mjs",
    "./client": {
      "browser": "./client.js",
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./session-bridge": "./src/plugins/session-bridge.mjs",
    "./session-sync": "./src/plugins/session-sync.mjs",
    "./session-router": "./src/plugins/session-router.mjs",
    "./decision-center": "./src/plugins/decision-center.mjs",
    "./contract": "./src/contract/index.js"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.js",
    "client.js",
    "tools/recover-queue.mjs",
    "tools/mcp/**/*.mjs",
    "tools/decision-ingest.mjs",
    "tools/desktop-launch.mjs",
    "tools/boot-guard.mjs",
    "cordis.patch.yml",
    "docs/PM-DECISION-POLICY.md",
    "docs/WORKFLOW-UI.md",
    "docs/CRASH-SAFETY.md",
    "docs/FORK-SEED.md",
    "docs/DECISION-RELAY.md",
    "docs/CONTRACT-INTEROP.md",
    "locale/*.json",
    "icon.svg",
    "LICENSE-CORE",
    "LICENSE-SDK",
    "LICENSE-COMMERCIAL",
    "NOTICE",
    "CLA.md",
    "LICENSES/**",
    "sdk/**",
    "defaults/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:dom": "node --test --test-concurrency=1 test/client-inbox-dom.test.mjs",
    "check": "node tools/fangctl.mjs verify",
    "doctor": "node tools/fangctl.mjs doctor",
    "preflight": "node tools/release/preflight.mjs",
    "acceptance": "node tools/release/preflight.mjs --e2e --json",
    "build": "node tools/release/build.mjs",
    "healthz": "node tools/release/healthz.mjs",
    "compat": "node tools/release/compat.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "publish:npm": "node tools/release/publish-npm.mjs",
    "typecheck": "node tools/release/typecheck.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@twinsearth/dsh-fang-queue-journal": "^0.1.6",
    "@twinsearth/dsh-fang-web-entry": "0.1.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  }
}
